# Cấu hình Firebase Web App (chỉ điền vào .env.local trên máy của bạn)
# VITE_* được đưa vào frontend build; KHÔNG lưu private key, password hoặc TOTP secret.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_USE_FIREBASE_EMULATOR=false
# Tùy chọn: đăng nhập bằng username "admin" được ánh xạ tới email thật dưới đây.
VITE_ADMIN_LOGIN_EMAIL=admin@example.com
